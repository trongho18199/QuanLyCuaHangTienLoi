<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:ns1="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="StoreName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>CỬA HÀNG TIỆN LỢI</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.8cm</Height><Width>18cm</Width><Style><Border><Style>None</Style></Border></Style></Textbox>
      <Textbox Name="ReportTitle"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>HÓA ĐƠN BÁN HÀNG</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Top>0.85cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>18cm</Width><Style><Border><Style>None</Style></Border></Style></Textbox>
      <Textbox Name="Cancelled"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!CancelledText.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>Firebrick</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Top>1.5cm</Top><Left>0cm</Left><Height>0.5cm</Height><Width>18cm</Width><Style><Border><Style>None</Style></Border></Style></Textbox>
      <Textbox Name="InvoiceInfo"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Số hóa đơn: " &amp; Parameters!InvoiceNumber.Value &amp; vbCrLf &amp; "Thời gian: " &amp; Parameters!CreatedAt.Value &amp; vbCrLf &amp; "Khách hàng: " &amp; Parameters!CustomerName.Value &amp; vbCrLf &amp; "Thu ngân: " &amp; Parameters!Cashier.Value &amp; vbCrLf &amp; "Thanh toán: " &amp; Parameters!PaymentMethod.Value &amp; IIf(Parameters!PaymentReference.Value = "", "", vbCrLf &amp; "Mã chuyển khoản: " &amp; Parameters!PaymentReference.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Top>2.1cm</Top><Left>0cm</Left><Height>2.4cm</Height><Width>18cm</Width><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox>
      <Tablix Name="InvoiceTable">
        <TablixBody><TablixColumns><TablixColumn><Width>1cm</Width></TablixColumn><TablixColumn><Width>8cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn></TablixColumns>
          <TablixRows>
            <TablixRow><Height>0.7cm</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="hNo"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>STT</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>Gray</Color><Style>Solid</Style></Border><BackgroundColor>#E8EEF2</BackgroundColor><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="hProduct"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Sản phẩm</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>Gray</Color><Style>Solid</Style></Border><BackgroundColor>#E8EEF2</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="hQty"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>SL</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>Gray</Color><Style>Solid</Style></Border><BackgroundColor>#E8EEF2</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="hPrice"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Đơn giá</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>Gray</Color><Style>Solid</Style></Border><BackgroundColor>#E8EEF2</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="hAmount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Thành tiền</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>Gray</Color><Style>Solid</Style></Border><BackgroundColor>#E8EEF2</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
            <TablixRow><Height>0.65cm</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="dNo"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!No.Value</Value></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGray</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="dProduct"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ProductName.Value</Value></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGray</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="dQty"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!Quantity.Value, "N0")</Value></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGray</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="dPrice"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!UnitPrice.Value, "N0")</Value></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGray</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="dAmount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!LineTotal.Value, "N0")</Value></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGray</Color><Style>Solid</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember><TablixMember><Group Name="Details" /></TablixMember></TablixMembers></TablixRowHierarchy>
        <DataSetName>InvoiceLines</DataSetName><Top>4.7cm</Top><Left>0cm</Left><Height>1.35cm</Height><Width>18cm</Width><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style>
      </Tablix>
      <Textbox Name="Summary"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Tiền hàng: " &amp; Parameters!Subtotal.Value &amp; vbCrLf &amp; "Giảm giá thành viên: " &amp; Parameters!MemberDiscount.Value &amp; vbCrLf &amp; "Khuyến mãi: " &amp; Parameters!Promotion.Value &amp; vbCrLf &amp; "THÀNH TIỀN: " &amp; Parameters!Total.Value &amp; vbCrLf &amp; "Tiền khách đưa: " &amp; Parameters!CashReceived.Value &amp; vbCrLf &amp; "Tiền thừa: " &amp; Parameters!Change.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>6.3cm</Top><Left>7cm</Left><Height>3.2cm</Height><Width>11cm</Width><Style><Border><Style>None</Style></Border><PaddingRight>2pt</PaddingRight></Style></Textbox>
      <Textbox Name="Thanks"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Cảm ơn quý khách và hẹn gặp lại!</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontStyle>Italic</FontStyle></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Top>9.7cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>18cm</Width><Style><Border><Style>None</Style></Border></Style></Textbox>
    </ReportItems>
    <Height>10.5cm</Height><Style />
  </Body>
  <Width>18cm</Width>
  <Page><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>1.5cm</LeftMargin><RightMargin>1.5cm</RightMargin><TopMargin>1.2cm</TopMargin><BottomMargin>1.2cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page>
  <DataSources><DataSource Name="InvoiceData"><ConnectionProperties><DataProvider>System.Data.DataSet</DataProvider><ConnectString>/* Local Connection */</ConnectString></ConnectionProperties><ns1:DataSourceID>7b34bb86-6bc2-4920-a763-e782260a6dcf</ns1:DataSourceID></DataSource></DataSources>
  <DataSets><DataSet Name="InvoiceLines"><Query><DataSourceName>InvoiceData</DataSourceName><CommandText>/* Local Query */</CommandText></Query><Fields><Field Name="No"><DataField>No</DataField><ns1:TypeName>System.Int32</ns1:TypeName></Field><Field Name="ProductName"><DataField>ProductName</DataField><ns1:TypeName>System.String</ns1:TypeName></Field><Field Name="Quantity"><DataField>Quantity</DataField><ns1:TypeName>System.Int32</ns1:TypeName></Field><Field Name="UnitPrice"><DataField>UnitPrice</DataField><ns1:TypeName>System.Decimal</ns1:TypeName></Field><Field Name="LineTotal"><DataField>LineTotal</DataField><ns1:TypeName>System.Decimal</ns1:TypeName></Field></Fields></DataSet></DataSets>
  <ReportParameters>
    <ReportParameter Name="InvoiceNumber"><DataType>String</DataType><Prompt>InvoiceNumber</Prompt></ReportParameter><ReportParameter Name="CreatedAt"><DataType>String</DataType><Prompt>CreatedAt</Prompt></ReportParameter><ReportParameter Name="CustomerName"><DataType>String</DataType><Prompt>CustomerName</Prompt></ReportParameter><ReportParameter Name="Cashier"><DataType>String</DataType><Prompt>Cashier</Prompt></ReportParameter><ReportParameter Name="PaymentMethod"><DataType>String</DataType><Prompt>PaymentMethod</Prompt></ReportParameter><ReportParameter Name="PaymentReference"><DataType>String</DataType><AllowBlank>true</AllowBlank><Prompt>PaymentReference</Prompt></ReportParameter><ReportParameter Name="CancelledText"><DataType>String</DataType><AllowBlank>true</AllowBlank><Prompt>CancelledText</Prompt></ReportParameter><ReportParameter Name="Subtotal"><DataType>String</DataType><Prompt>Subtotal</Prompt></ReportParameter><ReportParameter Name="MemberDiscount"><DataType>String</DataType><Prompt>MemberDiscount</Prompt></ReportParameter><ReportParameter Name="Promotion"><DataType>String</DataType><Prompt>Promotion</Prompt></ReportParameter><ReportParameter Name="Total"><DataType>String</DataType><Prompt>Total</Prompt></ReportParameter><ReportParameter Name="CashReceived"><DataType>String</DataType><Prompt>CashReceived</Prompt></ReportParameter><ReportParameter Name="Change"><DataType>String</DataType><Prompt>Change</Prompt></ReportParameter>
  </ReportParameters>
  <Language>vi-VN</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace><ns1:ReportUnitType>Cm</ns1:ReportUnitType><ns1:ReportID>82cd9634-7712-44ba-b3a6-22d91c6c1227</ns1:ReportID>
